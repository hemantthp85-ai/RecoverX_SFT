# ─────────────────────────────────────────────────────────────────────────────
# RecoverX Backend — Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit your real .env file to Git!
# ─────────────────────────────────────────────────────────────────────────────

# MongoDB
MONGODB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/
DATABASE_NAME=recoverx

# JWT Authentication
# Generate a secure secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-very-long-random-secret-key-here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS — comma-separated list of allowed frontend origins
# For local Flutter/web dev use http://localhost:3000 or http://localhost:8080
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
